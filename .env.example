# Relayer wallet — a plain EOA, no account abstraction.
# NEVER commit the real value. Use a FRESH wallet for mainnet — don't reuse
# the one from testnet — and fund it with a small amount of USDC for gas.
RELAYER_PRIVATE_KEY=0xyour_private_key

# Your deployed SavingsVault.sol address (Arc mainnet)
VAULT_ADDRESS=0xyour_vault_address

# USDC token address. Arc's native gas token — same address on testnet and mainnet.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Arc mainnet RPC (verified against docs.arc.io). No free public WSS exists for
# mainnet, and this app only uses HTTP polling (see src/utils/watchLogs.ts),
# so there's no ARC_RPC_WSS var to set.
ARC_RPC_HTTP=https://rpc.mainnet.arc.io
# Fallback / alternative: https://rpc.arc-scan.org (also verified live, chain 5042)

# Block your vault was deployed at (find it on https://explorer.arc.io) — keeps
# startup backfill from scanning the whole chain from genesis.
VAULT_DEPLOY_BLOCK=0

# Optional — Render sets this automatically. Only needed for local runs
# if you want the dashboard on a port other than 3000.
PORT=3000
